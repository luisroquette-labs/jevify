{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jevify operator smoke scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "completed", "graphify_usefulness", "jevify_usefulness", "preferred_next",
    "novel_source_verified", "known_false_freshness", "known_false_update",
    "known_paid_requests", "validation_failure_count", "decision"
  ],
  "properties": {
    "completed": { "type": "boolean" },
    "graphify_usefulness": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "jevify_usefulness": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "preferred_next": {
      "type": ["string", "null"],
      "enum": ["graphify", "jevify", "neither", null]
    },
    "novel_source_verified": { "type": "boolean" },
    "known_false_freshness": { "type": "integer", "minimum": 0 },
    "known_false_update": { "type": "integer", "minimum": 0 },
    "known_paid_requests": { "type": "integer", "minimum": 0 },
    "validation_failure_count": { "type": "integer", "minimum": 0 },
    "decision": {
      "type": "string",
      "enum": ["proceed_to_external_validation", "revise_or_extension", "invalid_smoke"]
    }
  }
}
