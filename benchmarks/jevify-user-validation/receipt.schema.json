{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luisroquette-labs.github.io/jevify/schemas/operator-smoke-receipt-v3.json",
  "title": "Jevify private operator smoke receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "stage", "operator_id", "tool_order", "recorded_at",
    "candidate_commit", "freshness_correct", "update_correct", "graphify_usefulness",
    "jevify_usefulness", "preferred_next", "jevify_only_novel_source_verified",
    "paid_request_count", "graphify_run_sha256", "jevify_run_sha256",
    "graphify_start_graph_sha256", "jevify_start_graph_sha256",
    "graphify_start_manifest_sha256", "jevify_start_manifest_sha256",
    "graphify_diff_sha256", "jevify_diff_sha256"
  ],
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "properties": {
    "schema_version": { "const": 3 },
    "stage": { "const": "operator_smoke" },
    "operator_id": { "const": "operator-01" },
    "tool_order": { "const": ["graphify", "jevify"] },
    "recorded_at": { "type": "string", "format": "date-time" },
    "candidate_commit": { "$ref": "#/$defs/sha1" },
    "freshness_correct": { "type": "boolean" },
    "update_correct": { "type": "boolean" },
    "graphify_usefulness": { "type": "integer", "minimum": 1, "maximum": 5 },
    "jevify_usefulness": { "type": "integer", "minimum": 1, "maximum": 5 },
    "preferred_next": { "enum": ["graphify", "jevify", "neither"] },
    "jevify_only_novel_source_verified": { "type": "boolean" },
    "paid_request_count": { "type": "integer", "minimum": 0 },
    "graphify_run_sha256": { "$ref": "#/$defs/sha256" },
    "jevify_run_sha256": { "$ref": "#/$defs/sha256" },
    "graphify_start_graph_sha256": { "$ref": "#/$defs/sha256" },
    "jevify_start_graph_sha256": { "$ref": "#/$defs/sha256" },
    "graphify_start_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "jevify_start_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "graphify_diff_sha256": { "$ref": "#/$defs/sha256" },
    "jevify_diff_sha256": { "$ref": "#/$defs/sha256" }
  }
}
